# Supabase backend configuration
# Copy this file to .env.local and fill in your project values.
# .env.local is gitignored and never committed.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend email service (server-side only)
# Used by the Vercel serverless function in api/send-email.js.
# These are NOT prefixed with VITE_ because they must never reach the client bundle.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Koom Week Seoul <hello@koomseoul.com>
